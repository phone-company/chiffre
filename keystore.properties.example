# Kopiere diese Datei nach keystore.properties und trage deine Werte ein.
# keystore.properties steht in .gitignore und darf nie ins Repository.
# storeFile muss ein absoluter Pfad sein, ohne ~ am Anfang.
storeFile=/Users/DEIN-NAME/Schluessel/chiffre/chiffre-release.jks
storePassword=HIER-DAS-KEYSTORE-PASSWORT
keyAlias=chiffre
